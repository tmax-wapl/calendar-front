    "axios": "^0.27.2",
    "fullcalendar": "^5.11.3",
    "keen-slider": "^6.8.5",
    "luxon": "^3.1.0",
    "mobx": "^6.6.2",
    "mobx-react": "^7.5.3",
    "mobx-react-lite": "^3.4.0",
    "moment": "^2.29.4",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-split-pane": "^0.1.92",
    "react-swipeable": "^7.0.0",
    "rrule": "^2.7.1",
    "swiper": "^9.3.2"
  },
