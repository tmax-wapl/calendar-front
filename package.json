{
  "name": "@wapl/calendar",
  "version": "0.0.14",
  "homepage": ".",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/*"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack-dev-server --open --hot --env dev=true develop=true",
    "dev:mobile": "cross-env NODE_ENV=development IS_MOBILE=true webpack-dev-server --open --hot --env dev=true develop=true",
    "dev:build": "cross-env NODE_ENV=production webpack --env dev=false develop=true && build.bat dev",
    "stag:build": "cross-env NODE_ENV=production webpack --env dev=false qa=false && build.bat stag",
    "qa:build": "cross-env NODE_ENV=production webpack --env dev=false qa=true && build.bat qa",
    "all:build": "yarn dev:build && yarn stag:build && yarn qa:build",
    "dev:build_mobile": "cross-env NODE_ENV=production IS_MOBILE=true webpack --env dev=false develop=true && build.bat dev_mobile",
    "stag:build_mobile": "cross-env NODE_ENV=production IS_MOBILE=true webpack --env dev=false qa=false && build.bat stag_mobile",
    "qa:build_mobile": "cross-env NODE_ENV=production IS_MOBILE=true webpack --env dev=false qa=true && build.bat qa_mobile",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "build": "rm -rf dist esm && tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --declarationDir dist && rollup -c rollup.config.js"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@fullcalendar/daygrid": "^5.11.3",
